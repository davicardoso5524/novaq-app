generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SUPERADMIN
  USER
}

enum TenantStatus {
  CONFIGURING
  ACTIVE
  PAUSED
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateKey {
  MODABELLA
  TEMPLATE_02
  TEMPLATE_03
  TEMPLATE_04
}

enum StoreSectionType {
  HERO
  CATEGORIES
  PRODUCT_FEED
  PROMOTIONS
  TESTIMONIALS
}

model Plan {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenants Tenant[]

  @@map("plans")
}

model Tenant {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  status       TenantStatus @default(CONFIGURING)
  publicDomain String?      @unique
  subdomain    String       @unique
  planId       String?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?    @db.Timestamptz(3)

  plan          Plan?            @relation(fields: [planId], references: [id], onDelete: SetNull)
  memberships   Membership[]
  mediaAssets   MediaAsset[]
  auditLogs     AuditLog[]
  categories    Category[]
  products      Product[]
  variants      ProductVariant[]
  productMedia  ProductMedia[]
  storeTheme    StoreTheme?
  storeSections StoreSection[]
  pageViews     PageView[]

  @@index([planId])
  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  hashedPassword String
  role           GlobalRole @default(USER)
  ativo          Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  auditLogs   AuditLog[]

  @@index([ativo])
  @@map("users")
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
  @@map("memberships")
}

model MediaAsset {
  id         String    @id @default(cuid())
  tenantId   String
  storageKey String
  url        String
  fileName   String
  mimeType   String
  sizeBytes  BigInt
  altText    String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productMedia ProductMedia[]

  @@unique([tenantId, storageKey])
  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@map("media_assets")
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@unique([id, tenantId])
  @@index([tenantId, active, position])
  @@map("categories")
}

model Product {
  id             String        @id @default(cuid())
  tenantId       String
  categoryId     String
  name           String
  slug           String
  description    String?
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  status         ProductStatus @default(DRAFT)
  publishedAt    DateTime?     @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  Category         @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  variants  ProductVariant[]
  media     ProductMedia[]
  pageViews PageView[]

  @@unique([tenantId, slug])
  @@unique([id, tenantId])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, categoryId, status])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  sku       String
  size      String
  color     String
  stock     Int      @default(0)
  price     Decimal? @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@unique([id, tenantId])
  @@index([tenantId, productId, active])
  @@map("product_variants")
}

model ProductMedia {
  id           String   @id @default(cuid())
  tenantId     String
  productId    String
  mediaAssetId String
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, productId, mediaAssetId])
  @@index([tenantId, productId, position])
  @@map("product_media")
}

model StoreTheme {
  id              String      @id @default(cuid())
  tenantId        String      @unique
  template        TemplateKey @default(MODABELLA)
  draftConfig     Json
  publishedConfig Json
  publishedAt     DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("store_themes")
}

model StoreSection {
  id        String           @id @default(cuid())
  tenantId  String
  type      StoreSectionType
  position  Int              @default(0)
  active    Boolean          @default(true)
  content   Json
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, position])
  @@index([tenantId, active, position])
  @@map("store_sections")
}

model PageView {
  id         String   @id @default(cuid())
  tenantId   String
  event      String
  path       String
  productId  String?
  searchTerm String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, event, createdAt])
  @@index([tenantId, productId, createdAt])
  @@map("page_views")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}
